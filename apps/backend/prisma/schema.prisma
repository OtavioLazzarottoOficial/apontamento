generator client {
  provider            = "prisma-client"
  output              = "../src/infra/database/prisma/generated"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model SequencingReport {
  id       String @id
  content  Json   @map("conteudo")
  version  Int    @map("versao")

  @@map("relatorios_sequenciamento")
}

enum UserRole {
  ADMINISTRADOR
  USUARIO

  @@map("PapelUsuario")
}

model User {
  id           String   @id
  email        String   @unique
  passwordHash String   @map("senha_hash")
  role         UserRole @map("papel")
  canEdit      Boolean  @default(false) @map("pode_editar")
  canExport    Boolean  @default(false) @map("pode_exportar")

  @@map("usuarios")
}

model CapacityConfiguration {
  id                   Int @id
  efficiencyPercentage Int @default(80) @map("eficiencia_percentual")

  @@map("configuracao_capacidade")
}

model Machine {
  id String @id
  name String
  pdfTitle String @map("pdf_title")

  @@map("machines")
}
