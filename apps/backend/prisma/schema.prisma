generator client {
  provider            = "prisma-client"
  output              = "../src/infra/database/prisma/generated"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// Adicione modelos somente ao implementar as funcionalidades do sistema.

model RelatorioSequenciamento {
  id       String @id
  conteudo Json
  versao   Int

  @@map("relatorios_sequenciamento")
}

enum PapelUsuario {
  ADMINISTRADOR
  USUARIO
}

model Usuario {
  id              String       @id
  email           String       @unique
  senhaHash       String       @map("senha_hash")
  papel           PapelUsuario
  podeEditar      Boolean      @default(false) @map("pode_editar")
  podeExportar    Boolean      @default(false) @map("pode_exportar")

  @@map("usuarios")
}
