{
  "name": "apontamento",
  "private": true,
  "version": "0.0.0",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "db:up": "docker compose up -d --wait db",
    "db:stop": "docker compose stop db",
    "user:create": "npm run env:init -w @repo/backend && node apps/backend/scripts/create-user.mjs"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  },
  "overrides": {
    "@prisma/config": {
      "effect": "3.22.1"
    },
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
